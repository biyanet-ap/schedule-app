{
  "name": "claude-sc-schedule",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode mock",
    "build": "vue-tsc -b && vite build && node scripts/copy-to-gas.mjs",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "push": "npm run test && npm run build && clasp push -f",
    "release": "npm run test && npm run build && node scripts/make-release.mjs"
  },
  "dependencies": {
    "@fullcalendar/vue3": "7.1.0",
    "temporal-polyfill": "1.0.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.13",
    "@types/google.script.client-side": "0.1.5",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
